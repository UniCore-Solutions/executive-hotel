# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend GraphQL gateway — BROWSER requests.
# Default "/api/graphql" hits this app's own route handler (app/api/graphql/
# route.ts), which forwards to the backend and injects the Bearer token from
# the httpOnly session cookie server-side — the browser itself never sees the
# token (see lib/session.ts). Set an absolute URL only if the browser should
# call a different API origin directly (loses the session-cookie injection).
# NEXT_PUBLIC_API_URL=/api/graphql

# Backend GraphQL gateway — SERVER-side requests (RSC / route handlers).
# Must be reachable from wherever the Next.js server runs.
#   local dev:  http://127.0.0.1:8180/graphql   (default)
#   docker:     http://backend:8180/graphql
# API_INTERNAL_URL=http://127.0.0.1:8180/graphql

# Backend's host-reachable address — used only by /api/auth/google/start,
# which redirects the BROWSER (not a server-side fetch) to the backend for
# the Google OAuth flow. Must resolve from wherever the browser runs, unlike
# API_INTERNAL_URL above — in Docker that's the published host port, never
# the internal "backend" service hostname (which the browser can't resolve).
#   local dev:  http://localhost:8180  (default)
#   docker:     http://localhost:8180  (the published port, not "backend")
# BACKEND_PUBLIC_URL=http://localhost:8180

# Platform slug for the platform-identity + hero services (Phase 1-2)
NEXT_PUBLIC_PLATFORM_SLUG=executive-hotel

# Feature flags
NEXT_PUBLIC_ENABLE_CHATBOT=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Currency (display-only rates; billing is always MAD)
NEXT_PUBLIC_FX_MAD=1
NEXT_PUBLIC_FX_EUR=0.091
NEXT_PUBLIC_FX_USD=0.100
NEXT_PUBLIC_FX_GBP=0.078

# Mock backend settings.
# true  -> platform/catalog services use the static fixture (keeps tests deterministic)
# false -> platform/catalog services query the GraphQL gateway and fall back to the fixture on failure (default)
NEXT_PUBLIC_USE_MOCK_SERVICES=false

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/ARCHITECTURE.md"],
  "permission": {
    "bash": { "git *": "allow", "npm *": "allow", "npx *": "allow", "node *": "allow", "*": "ask" },
    "external_directory": {
      "/home/hotel-executive/**": "allow",
      "/tmp/opencode/hotel/hotel-html/**": "allow",
      "*": "ask"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "tool_output": { "max_lines": 250 },
  "agent": {
    "reviewer": { "mode": "subagent", "permission": { "edit": "deny" } },
    "security": { "mode": "subagent", "permission": { "edit": "deny" } },
    "visual-qa": { "mode": "subagent", "permission": { "edit": "deny" } },
    "explorer": { "mode": "subagent" },
    "architect": { "mode": "subagent", "permission": { "edit": "deny" } },
    "planner": { "mode": "subagent", "permission": { "edit": "deny" } },
    "docs": { "mode": "subagent" }
  }
}
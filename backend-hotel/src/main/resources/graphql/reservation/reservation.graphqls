extend type Query {
	myReservations: [Reservation!]!
	reservation(input: ReservationLookupInput!): Reservation
	adminReservations(hotelId: ID!, status: ReservationStatus, page: PageInput): ReservationPage!
	adminGuests(hotelId: ID!, query: String, page: PageInput): AdminGuestPage!
}

type Reservation {
	id: ID!
	reference: String!
	hotelId: ID!
	status: ReservationStatus!
	paymentStatus: PaymentStatus!
	checkInDate: LocalDate!
	checkOutDate: LocalDate!
	adults: Int!
	children: Int!
	currencyCode: String!
	subtotalAmount: Float!
	discountAmount: Float!
	taxAmount: Float!
	feeAmount: Float!
	totalAmount: Float!
	source: String!
	notes: String
	createdAt: DateTime!
	guest: ReservationGuestInfo!
	roomLines: [ReservationRoomLine!]!
	extras: [ReservationExtraLine!]!
	charges: [ReservationChargeLine!]!
	cancellation: ReservationCancellation
}

enum ReservationStatus {
	pending
	confirmed
	modified
	cancelled
	checked_in
	checked_out
	no_show
}

type ReservationGuestInfo {
	id: ID
	firstName: String!
	lastName: String!
	email: String
	phone: String
	countryCode: String
}

type ReservationRoomLine {
	id: ID!
	roomTypeId: ID!
	ratePlanId: ID!
	checkInDate: LocalDate!
	checkOutDate: LocalDate!
	nights: Int!
	ratePerNight: Float!
	subtotalAmount: Float!
	status: String!
	# Resolved from the current catalog (roomLines persist only the room-type
	# id) — the display identity for confirmation/lookup/check-in views.
	roomTypeName: String!
	roomTypeImageUrl: String
	# Resolved from the current rate catalog (roomLines persist only the
	# rate-plan id) — the display name for confirmation/lookup views.
	ratePlanName: String
	# Cancellation terms of this line's rate plan, resolved from the current
	# rate catalog (roomLines persist only the rate-plan id, not its policy).
	# false means the full room subtotal is forfeited on cancellation,
	# regardless of freeCancellationUntil.
	isRefundable: Boolean!
	# The last date free cancellation is available, or null when the rate
	# plan is non-refundable OR refundable with no free-cancellation window
	# at all (a penalty always applies) — in neither case is there a
	# meaningful date to show. Never compute a cancellation FEE amount from
	# these two fields client-side; only the actual cancel action (backend)
	# is authoritative for the exact charge.
	freeCancellationUntil: LocalDate
	# Settlement terms of this line's rate plan (pay_at_property | prepay_full
	# | prepay_deposit), resolved from the current rate catalog. A
	# pay-at-property stay sits at paymentStatus 'pending' by design — nothing
	# is owed online — so displays need this to tell the two apart.
	paymentTiming: String!
}

type ReservationExtraLine {
	id: ID!
	extraId: ID!
	name: String!
	quantity: Int!
	unitPrice: Float!
	totalPrice: Float!
}

type ReservationChargeLine {
	id: ID!
	name: String!
	chargeType: String!
	amount: Float!
}

type ReservationCancellation {
	id: ID!
	reason: String
	reasonNote: String
	isRefundable: Boolean!
	penaltyAmount: Float!
	refundAmount: Float!
	cancelledAt: DateTime!
}

type ReservationPage {
	total: Int!
	page: Int!
	size: Int!
	items: [Reservation!]!
}

input ReservationLookupInput {
	reference: String!
	email: String!
}

input CreateReservationInput {
	hotelId: ID!
	checkInDate: LocalDate!
	checkOutDate: LocalDate!
	adults: Int!
	children: Int!
	currencyCode: String!
	guest: ReservationGuestInput!
	rooms: [ReservationRoomInput!]!
	extras: [ReservationExtraInput!]
	promoCode: String
	idempotencyKey: String!
}

input ReservationGuestInput {
	firstName: String!
	lastName: String!
	email: String!
	phone: String
	countryCode: String
}

input ReservationRoomInput {
	roomTypeId: ID!
	ratePlanId: ID!
}

input ReservationExtraInput {
	extraId: ID!
	quantity: Int!
}

input CancelReservationInput {
	reference: String!
	email: String!
	reasonCode: String
	reasonNote: String
}

type AdminGuestPage {
	total: Int!
	page: Int!
	size: Int!
	items: [AdminGuest!]!
}

type AdminGuest {
	id: ID!
	firstName: String!
	lastName: String!
	email: String
	phone: String
	countryCode: String
	reservationsCount: Int!
	totalSpent: Float!
	lastStayDate: LocalDate
}
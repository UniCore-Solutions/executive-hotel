extend type Query {
	adminDashboard(hotelId: ID!): AdminDashboard!
}

type AdminDashboard {
	hotelId: ID!
	hotelName: String!
	arrivalsToday: Int!
	departuresToday: Int!
	inHouseToday: Int!
	soldOutTonight: Int!
	occupancyPct: Float!
	availableTonight: Int!
	revenueTotal: Float!
	pendingPayments: Int!
	pendingInvoices: Int!
	recentReservations: [Reservation!]!
}
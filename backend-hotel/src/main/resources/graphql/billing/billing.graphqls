extend type Query {
	adminPayments(hotelId: ID!, search: String, sort: String, page: PageInput): PaymentPage!
	adminInvoices(hotelId: ID!, page: PageInput): InvoicePage!
}

enum PaymentStatus {
	pending
	authorized
	captured
	failed
	refunded
	partially_refunded
}

type Payment {
	id: ID!
	reservationId: ID!
	amount: Float!
	currencyCode: String!
	status: PaymentStatus!
	provider: String!
	providerReference: String
	createdAt: DateTime!
}

input CreatePaymentInput {
	reservationId: ID!
	amount: Float!
	currencyCode: String!
	provider: String!
	idempotencyKey: String!
	"""Guest email on file for an accountless reservation — required proof of
	possession when the caller is not authenticated as the reservation's owner
	or hotel staff, mirroring the reference+email pattern used by reservation
	lookup/cancel."""
	guestEmail: String
}

input CapturePaymentInput {
	paymentId: ID!
	"""See CreatePaymentInput.guestEmail — the same proof is re-checked here
	since capture independently re-validates access."""
	guestEmail: String
}

type Invoice {
	id: ID!
	invoiceNumber: String!
	reservationId: ID!
	billingName: String!
	currencyCode: String!
	subtotalAmount: Float!
	discountAmount: Float!
	taxAmount: Float!
	feeAmount: Float!
	totalAmount: Float!
	status: String!
	issuedAt: DateTime!
	items: [InvoiceItem!]!
}

type InvoiceItem {
	id: ID!
	description: String!
	itemType: String!
	quantity: Float!
	unitPrice: Float!
	totalPrice: Float!
}

type PaymentPage {
	total: Int!
	page: Int!
	size: Int!
	items: [Payment!]!
}

type InvoicePage {
	total: Int!
	page: Int!
	size: Int!
	items: [Invoice!]!
}
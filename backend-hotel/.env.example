# Copy to .env (never committed) and export: `set -a; source .env; set +a`
# Required — the app refuses to start without a strong JWT secret:
#   openssl rand -hex 32
JWT_SECRET=

# Optional (defaults shown)
JWT_TTL_MINUTES=60
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hotel_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KAFKA_BOOTSTRAP=localhost:9092
MEDIA_STORAGE_PATH=./data/media
MEDIA_BASE_URL=http://localhost:8180
OUTBOX_RELAY_INTERVAL_MS=1000
CORS_ALLOWED_ORIGINS=*

# Google OAuth2/OIDC SSO — blank GOOGLE_CLIENT_ID disables Google sign-in
# entirely (no other config here is read until a client id is set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8180/api/auth/google/callback
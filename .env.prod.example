# ============================================================================
# Hotel Collection platform — PRODUCTION environment configuration
#
# Copy this to `.env` ON THE PROD SERVER (169.58.245.212), fill in the blanks,
# then deploy:
#
#   cp .env.prod.example .env
#   openssl rand -hex 32          # → JWT_SECRET
#   openssl rand -hex 24          # → POSTGRES_PASSWORD (or any strong value)
#   ./scripts/start.sh --prod --build
#
# `scripts/start.sh --prod` adds the docker-compose.prod.yml overlay: Postgres/
# Kafka lose their host port bindings (internal network only), Spring runs
# with `SPRING_PROFILES_ACTIVE=prod` (GraphiQL + introspection off, CSP header
# on), and CORS_ALLOWED_ORIGINS becomes REQUIRED (no "*" wildcard fallback).
#
# This template assumes the server is reached directly by IP:port (no domain
# name, no TLS/reverse proxy yet) — see the Google OAuth warning below, the
# one piece that doesn't fully work under that assumption.
# ============================================================================

# --- Security ---------------------------------------------------------------
# REQUIRED. Generate a fresh one — never reuse a value from a dev .env.
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=60

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=hotel_platform
POSTGRES_USER=hotel_app
# REQUIRED. Generate a fresh one — never reuse a value from a dev .env.
POSTGRES_PASSWORD=
# Ignored under the --prod overlay (docker-compose.prod.yml sets `ports: []`
# for postgres unconditionally — it is never reachable from outside the
# Docker network in prod, regardless of this value).
POSTGRES_HOST_PORT=5433

# --- Kafka --------------------------------------------------------------
# Same note as POSTGRES_HOST_PORT — unbound entirely under --prod.
KAFKA_HOST_PORT=9092

# --- Backend (Spring Boot) --------------------------------------------------
BACKEND_PORT=8180
# Base URL used to build public media/image URLs served by the backend —
# must be an address the BROWSER can resolve, i.e. this server's public IP.
MEDIA_BASE_URL=http://169.58.245.212:8180
# REQUIRED under --prod (no "*" wildcard allowed). Every origin a browser
# will load one of this platform's frontends from.
CORS_ALLOWED_ORIGINS=http://169.58.245.212:3100,http://169.58.245.212:3101,http://169.58.245.212:3102
OUTBOX_RELAY_INTERVAL_MS=1000
RESERVATION_HOLD_MINUTES=15
RESERVATION_HOLD_EXPIRY_INTERVAL_MS=60000
PAYMENT_SIMULATED_DELAY_MIN_MS=1500
PAYMENT_SIMULATED_DELAY_MAX_MS=4000
# MUST be false in prod — PaymentSafetyConfig refuses to start otherwise
# (there is no real payment gateway behind this yet; "true" fabricates
# successful settlement with no money movement).
PAYMENT_AUTO_SETTLE_ENABLED=false
# Shared secret for the manual payment webhook (/api/v1/payments/{id}/webhook).
# Leave blank to have that endpoint reject every call, unless you're actually
# using it to settle payments in this environment.
PAYMENT_WEBHOOK_SECRET=
JVM_OPTS=

# --- Email notifications ------------------------------------------------
# "simulated" logs the rendered email and sends nothing — safe default until
# real SMTP credentials are ready. Switch to "smtp" once MAIL_* below is set.
EMAIL_PROVIDER=simulated
EMAIL_FROM_ADDRESS=no-reply@hotel-platform.local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Guest site base URL — used only to build links inside emails (manage
# booking, retry payment, account).
FRONTEND_BASE_URL=http://169.58.245.212:3100

# --- Frontends --------------------------------------------------------------
FRONTEND_PORT=3100
BACKOFFICE_PORT=3101
ADMIN_PORT=3102

# --- Frontend build args (baked into the frontend image at build time —
# changing these after the fact requires `./scripts/build.sh --frontend`) ----
NEXT_PUBLIC_USE_MOCK_SERVICES=false
NEXT_PUBLIC_PLATFORM_SLUG=executive-hotel
NEXT_PUBLIC_APP_URL=http://169.58.245.212:3100
NEXT_PUBLIC_FX_EUR=0.091
NEXT_PUBLIC_FX_USD=0.100
NEXT_PUBLIC_FX_GBP=0.078
NEXT_PUBLIC_ENABLE_CHATBOT=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# --- Operational behaviour (scripts/) ---------------------------------------
# Do NOT seed demo/fixture data into a real production database.
SEED_ON_START=false

# --- Google OAuth2/OIDC SSO --------------------------------------------------
# WARNING: Google's OAuth console rejects raw IP addresses in "Authorized
# redirect URIs" for web-application clients — it requires either a real
# domain name over HTTPS, or http://localhost for local testing. A bare
# "http://169.58.245.212/..." redirect URI will most likely fail to save in
# Google Cloud Console at all, meaning Google sign-in CANNOT work against
# this server until it has a domain name (and TLS in front of it).
#
# Leave GOOGLE_CLIENT_ID blank to disable Google sign-in entirely (the app
# handles this gracefully — see docs/AUTHENTICATION.md) until that's ready.
# Email/password login and OTP verification are unaffected either way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://169.58.245.212:8180/api/auth/google/callback

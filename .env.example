# ============================================================================
# Hotel Collection platform — environment configuration
#
# Copy to .env (never committed):  ./scripts/setup.sh  does this for you and
# generates a strong JWT_SECRET + database password automatically.
#
# Used by docker-compose.yml and every script in scripts/.
# ============================================================================

# --- Security ---------------------------------------------------------------
# REQUIRED. The backend refuses to start without a strong secret (>=32 bytes).
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=60

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=hotel_platform
POSTGRES_USER=hotel_app
# REQUIRED in the Docker stack. setup.sh generates a random one.
POSTGRES_PASSWORD=
# Host port binding (set empty ONLY via prod overlay; see docs/docker.md)
POSTGRES_HOST_PORT=5433

# --- Kafka ------------------------------------------------------------------
KAFKA_HOST_PORT=9092

# --- Backend (Spring Boot) --------------------------------------------------
BACKEND_PORT=8180
# Base URL used to build public media/image URLs served by the backend.
# Browsers must be able to resolve it, hence localhost — not "backend".
MEDIA_BASE_URL=http://localhost:8180
# Comma-separated browser origins allowed by CORS ("*" is fine for local dev;
# the prod overlay REQUIRES an explicit list, e.g.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3101)
CORS_ALLOWED_ORIGINS=*
OUTBOX_RELAY_INTERVAL_MS=1000
# Payment hold: a reservation is auto-cancelled and its inventory released if
# payment never captures within this window.
RESERVATION_HOLD_MINUTES=15
RESERVATION_HOLD_EXPIRY_INTERVAL_MS=60000
# Simulated payment-provider settlement delay (no real gateway exists).
PAYMENT_SIMULATED_DELAY_MIN_MS=1500
PAYMENT_SIMULATED_DELAY_MAX_MS=4000
# Simulated card settlement. TRUE IS A DEVELOPMENT-ONLY SETTING: it captures
# payments and confirms reservations with no money movement, so the backend
# defaults it to false and REFUSES TO START with it enabled under the 'prod'
# profile (see PaymentSafetyConfig). Set false to make every payment sit
# 'pending' until settled via the webhook or the admin trigger.
PAYMENT_AUTO_SETTLE_ENABLED=true
# Shared secret for the manual-QA payment webhook (/api/v1/payments/{id}/webhook).
# Left blank, that endpoint rejects every call. Set it only for local/QA testing
# of the simulated provider — never a real credential.
PAYMENT_WEBHOOK_SECRET=
# Optional extra JVM options passed to the backend container, e.g.
# JVM_OPTS=-Xmx1g -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
JVM_OPTS=

# --- Email notifications ------------------------------------------------
# simulated (default): logs the rendered email, delivers nothing — safe with
# no credentials set at all. smtp: delivers for real via MAIL_* below.
EMAIL_PROVIDER=simulated
EMAIL_FROM_ADDRESS=no-reply@hotel-platform.local
# Only used when EMAIL_PROVIDER=smtp. Gmail's SMTP relay is the reference
# target: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=<gmail address>,
# MAIL_PASSWORD=<a Gmail App Password — not your account password; Google
# Account > Security > 2-Step Verification > App passwords>. Any other
# SMTP-speaking provider works the same way — nothing in the code is
# Gmail-specific, only this configuration is.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Guest site base URL — used only to build links inside emails (manage
# booking, retry payment, account). Not served by the backend itself.
FRONTEND_BASE_URL=http://localhost:3000

# --- Frontends --------------------------------------------------------------
FRONTEND_PORT=3000
BACKOFFICE_PORT=3101
ADMIN_PORT=3102

# --- Frontend build args (baked into the frontend image at build time) ------
NEXT_PUBLIC_USE_MOCK_SERVICES=false
NEXT_PUBLIC_PLATFORM_SLUG=executive-hotel
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FX_EUR=0.091
NEXT_PUBLIC_FX_USD=0.100
NEXT_PUBLIC_FX_GBP=0.078
NEXT_PUBLIC_ENABLE_CHATBOT=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# --- Operational behaviour (scripts/) ---------------------------------------
# Seed development demo data on first start when the database has no hotels.
# Ignored when running with the prod overlay. Set false to disable.
SEED_ON_START=true
